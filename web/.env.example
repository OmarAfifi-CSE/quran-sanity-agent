# Local data mode works without secrets. Copy this file to web/.env.local.
# Use your own Sanity project to enable live reads.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
# Set local explicitly for reproducible offline demonstrations.
QURAN_DATA_MODE=

# Optional real Sanity Context integration: organization credentials, server only.
SANITY_CONTEXT_MCP_URL=
# Optional reference to the previous metadata Knowledge Base endpoint.
SANITY_CONTEXT_KB_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternative name accepted by the application; use one key variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Per-instance limits. A multi-instance public deployment also needs a shared edge limit.
QURAN_REQUESTS_PER_MINUTE=12
QURAN_MAX_CONCURRENT=4
QURAN_REQUESTS_PER_HOUR=120
# Only enable when your deployment proxy overwrites x-forwarded-for reliably.
QURAN_TRUST_PROXY=false
# Optional external origin if a proxy rewrites the request URL.
QURAN_PUBLIC_ORIGIN=
# Set off for an excerpt-only demo with no AI reading-note generation.
QURAN_RESEARCH_NOTES=on

# Editorial/import scripts only. Never prefix tokens with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
SANITY_IMPORT_DATASET=
