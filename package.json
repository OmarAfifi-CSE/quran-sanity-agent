{
  "name": "quran-sanity-agent-monorepo",
  "version": "1.0.0",
  "description": "Quran Sanity Agent Monorepo Workspace",
  "private": true,
  "workspaces": [
    "studio",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --prefix web",
    "dev:studio": "npm run dev --prefix studio",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "build:studio": "npm run build --prefix studio",
    "test": "npm run test --prefix web",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:text": "node scripts/verify-reference.mjs",
    "lint": "npm run lint --prefix web",
    "type-check": "npm run type-check --prefix web"
  },
  "overrides": {
    "@sanity/cli": "8.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "adm-zip": "0.6.1",
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "smol-toml": "1.7.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
